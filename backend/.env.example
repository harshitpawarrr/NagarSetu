# ==============================================================================
# NagarSetu Backend Environment Configuration
# DO NOT INCLUDE REAL API KEYS IN THIS TEMPLATE.
# ==============================================================================

# Server Settings
PROJECT_NAME="NagarSetu Civic Complaint Triage Engine"
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# CORS Settings (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL)
POSTGRES_USER=nagarsetu_user
POSTGRES_PASSWORD=nagarsetu_password
POSTGRES_DB=nagarsetu_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nagarsetu_user:nagarsetu_password@localhost:5432/nagarsetu_db

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# File Storage Paths (relative to backend or absolute)
DATA_RAW_DIR=../data/raw
DATA_PROCESSED_DIR=../data/processed
DATA_TEST_DIR=../data/test
GAZETTEER_PATH=../data/gazetteer/sample_wards_gazetteer.json
CONFIG_DIR=../config
PROMPTS_DIR=../prompts

# Pipeline Tuning Parameters
CONFIDENCE_THRESHOLD_ROUTING=0.75
CONFIDENCE_THRESHOLD_DUPLICATE=0.85
CONFIDENCE_THRESHOLD_NORMAL=0.80
CONFIDENCE_THRESHOLD_ATTENTION=0.50
CLUSTER_SIMILARITY_THRESHOLD=0.82
ENABLE_STRICT_DETERMINISTIC_VALIDATION=True
PROMPT_VERSION=classification_v1.0
URGENCY_PROMPT_VERSION=urgency_v1.0
