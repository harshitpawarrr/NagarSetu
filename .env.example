# ==============================================================================
# NagarSetu Environment Configuration Template (Root)
# NOTE: DO NOT COMMIT REAL SECRETS OR PRODUCTION API KEYS.
# ==============================================================================

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Frontend Service
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://nagar-setu-psi.vercel.app

# PostgreSQL Database (Required in future phases)
POSTGRES_USER=nagarsetu_user
POSTGRES_PASSWORD=nagarsetu_password
POSTGRES_DB=nagarsetu_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nagarsetu_user:nagarsetu_password@localhost:5432/nagarsetu_db

# Gemini AI Configuration (Required for AI Triage & Preprocessing)
# Provide your Gemini API key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Operational Parameters
DEFAULT_ZONE=Central Zone
CONFIDENCE_THRESHOLD_ROUTING=0.75
CONFIDENCE_THRESHOLD_DUPLICATES=0.85
MAX_BATCH_INGEST_SIZE=500
