# NagarSetu .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node / Frontend
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/dist/
dist/
.eslintcache

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Database & local state
*.sqlite3
*.db
local_storage/
backups/

# IDE & OS files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Large multimodal complaint files & exports (keep folder structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md
data/test/*
!data/test/.gitkeep
!data/test/README.md
