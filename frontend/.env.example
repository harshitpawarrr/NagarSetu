# ==============================================================================
# NagarSetu Frontend Environment Configuration
# ==============================================================================

# Backend API base URL (both VITE_API_URL and VITE_API_BASE_URL are supported)
# In development:
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
# In production (e.g. Vercel deployment pointing to Render backend):
# VITE_API_URL=https://nagarsetu-s8qy.onrender.com/api/v1

# App title and branding
VITE_APP_TITLE="NagarSetu | Municipal Triage & Accountability Engine"
VITE_APP_SUBTITLE="Zone Operator Decision Support System"

# Feature toggles
VITE_ENABLE_MOCK_DATA=false
VITE_AUTO_REFRESH_INTERVAL_MS=30000
